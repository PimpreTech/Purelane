{{ 'purelane-combos.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Purelane Best-Selling Combos Section (Section 03)
  Renders a horizontal scrolling rail of pre-built bundle combo boxes.
{%- endcomment -%}

{%- liquid
  assign section_id = section.id
  assign kicker = section.settings.kicker
  assign title = section.settings.title
  assign show_rule = section.settings.show_rule
  assign lede = section.settings.lede
  assign swipecue_text = section.settings.swipecue_text
  assign railnote = section.settings.railnote
  assign enable_animations = section.settings.enable_animations
-%}

<div
  id="PurelaneCombos-{{ section_id }}"
  class="purelane-combos"
  data-section-id="{{ section_id }}"
  data-section-type="purelane-combos"
>
  <div class="purelane-combos__wrap">
    {%- if kicker != blank or title != blank or lede != blank -%}
      <div class="purelane-combos__head rv{% if enable_animations == false %} in{% endif %}">
        {%- if kicker != blank -%}
          <span class="purelane-combos__kicker">{{ kicker }}</span>
        {%- endif -%}
        {%- if title != blank -%}
          <h2 class="purelane-combos__title">{{ title }}</h2>
        {%- endif -%}
        {%- if show_rule -%}
          <div class="purelane-combos__rule" aria-hidden="true">
            <i></i>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
              <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
            </svg>
            <i></i>
          </div>
        {%- endif -%}
        {%- if lede != blank -%}
          <p class="purelane-combos__lede">{{ lede }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="comborail rv{% if enable_animations == false %} in{% endif %}" role="region" aria-label="{{ title | default: 'Best selling combos' }}" tabindex="0">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {% render 'purelane-combo-card',
            combo_product: block.settings.combo_product,
            title: block.settings.title,
            count_label: block.settings.count_label,
            description: block.settings.description,
            price: block.settings.price,
            compare_at_price: block.settings.compare_at_price,
            save_label: block.settings.save_label,
            save_badge: block.settings.save_badge,
            flag_badge: block.settings.flag_badge,
            is_hero: block.settings.is_hero,
            cta_text: block.settings.cta_text,
            cta_url: block.settings.cta_url,
            fine_print: block.settings.fine_print,
            item1_text: block.settings.item1_text,
            item1_sprite: block.settings.item1_sprite,
            item1_image: block.settings.item1_image,
            item2_text: block.settings.item2_text,
            item2_sprite: block.settings.item2_sprite,
            item2_image: block.settings.item2_image,
            item2_is_tile: block.settings.item2_is_tile,
            item3_text: block.settings.item3_text,
            item3_sprite: block.settings.item3_sprite,
            item3_image: block.settings.item3_image
          %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Default 5 Presets matching reference {%- endcomment -%}
        {% render 'purelane-combo-card',
          title: 'Kitchen essentials',
          count_label: '3 products',
          description: 'Includes: Foaming Kitchen Cleaner, Dishwash Gel & Tap Cleaner. Everything for a sparkling kitchen, no need to pick separately.',
          price: '₹499',
          compare_at_price: '₹897',
          save_label: 'Save ₹398',
          save_badge: 'You save ₹398',
          flag_badge: 'Most popular',
          is_hero: false,
          cta_text: 'Shop bundle',
          cta_url: '#bundles',
          item1_text: 'Cuts grease instantly',
          item1_sprite: 'p-kitchen',
          item2_text: 'Squeaky clean dishes',
          item2_sprite: 'p-dish',
          item3_text: 'Melts hard water stains',
          item3_sprite: 'p-tap'
        %}

        {% render 'purelane-combo-card',
          title: 'Laundry care bundle',
          count_label: '3 products',
          description: 'Includes: Laundry Detergent, Fabric Conditioner & Machine Cleaner Powder. Softer, fresher wash, all in one box.',
          price: '₹499',
          compare_at_price: '₹947',
          save_label: 'Save ₹448',
          save_badge: 'You save ₹448',
          is_hero: false,
          cta_text: 'Shop bundle',
          cta_url: '#bundles',
          item1_text: 'Removes tough stains & odour',
          item1_sprite: 'p-laundry',
          item2_text: 'Softens & freshens every wash',
          item2_is_tile: true,
          item3_text: 'Deep-cleans your machine',
          item3_sprite: 'p-wm'
        %}

        {% render 'purelane-combo-card',
          title: 'Complete home bundle',
          count_label: '5 products',
          description: 'Includes: Kitchen Cleaner, Laundry Detergent, Floor Cleaner, Toilet Cleaner & Handwash. Our biggest saving box.',
          price: '₹799',
          compare_at_price: '₹1,495',
          save_label: 'Save ₹696',
          save_badge: 'Biggest saving',
          flag_badge: 'Best value',
          is_hero: true,
          cta_text: 'Shop bundle',
          cta_url: '#bundles',
          item1_text: 'Cuts grease instantly',
          item1_sprite: 'p-kitchen',
          item2_text: 'Kills 99.9% germs',
          item2_sprite: 'p-floor',
          item3_text: 'Gentle hydration for hands',
          item3_sprite: 'p-handwash'
        %}

        {% render 'purelane-combo-card',
          title: 'Bathroom deep clean',
          count_label: '3 products',
          description: 'Includes: Toilet Cleaner, Tap Cleaner & Magic Eraser. A complete bathroom refresh in one box.',
          price: '₹499',
          compare_at_price: '₹897',
          save_label: 'Save ₹398',
          save_badge: 'You save ₹398',
          is_hero: false,
          cta_text: 'Shop bundle',
          cta_url: '#bundles',
          item1_text: 'Kills 99.9% germs',
          item1_sprite: 'p-toilet',
          item2_text: 'Melts hard water stains',
          item2_sprite: 'p-tap',
          item3_text: 'Scrubs away soap scum',
          item3_sprite: 'p-eraser'
        %}

        {% render 'purelane-combo-card',
          title: 'Hard water solution kit',
          count_label: '2 products',
          description: 'Includes: Tap Cleaner & Toilet Cleaner. A quick, focused fix for hard water stains across the home.',
          price: '₹349',
          compare_at_price: '₹598',
          save_label: 'Save ₹249',
          save_badge: 'You save ₹249',
          is_hero: false,
          cta_text: 'Shop bundle',
          cta_url: '#bundles',
          item1_text: 'Melts hard water stains',
          item1_sprite: 'p-tap',
          item2_text: 'Fights limescale in the bowl',
          item2_sprite: 'p-toilet'
        %}
      {%- endif -%}
    </div>

    {%- if swipecue_text != blank -%}
      <div class="swipecue" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h13m-5-6 6 6-6 6"/>
        </svg>
        {{ swipecue_text }}
      </div>
    {%- endif -%}

    {%- if railnote != blank -%}
      <p class="railnote">{{ railnote }}</p>
    {%- endif -%}
  </div>
</div>

{%- comment -%} Standalone sprite definitions ensuring Section 03 works with or without Section 01 {%- endcomment -%}
<style>
  #PurelaneCombos-{{ section_id }} {
    --p-kitchen:url("data:image/svg+xml;base64,");
    --p-dish:url("data:image/svg+xml;base64,");
    --p-tap:url("data:image/svg+xml;base64,");
    --p-laundry:url("data:image/svg+xml;base64,");
    --p-wm:url("data:image/svg+xml;base64,");
    --p-floor:url("data:image/svg+xml;base64,");
    --p-handwash:url("data:image/svg+xml;base64,");
    --p-toilet:url("data:image/svg+xml;base64,");
    --p-eraser:url("data:image/svg+xml;base64,");
  }
  #PurelaneCombos-{{ section_id }} .pimg {
    display: block;
    background-repeat: no-repeat;
    background-position: center bottom;
    background-size: contain;
    flex: 0 0 auto;
  }
  #PurelaneCombos-{{ section_id }} .p-kitchen { background-image: var(--p-kitchen); aspect-ratio: 0.6387; }
  #PurelaneCombos-{{ section_id }} .p-dish { background-image: var(--p-dish); aspect-ratio: 0.624; }
  #PurelaneCombos-{{ section_id }} .p-tap { background-image: var(--p-tap); aspect-ratio: 0.6387; }
  #PurelaneCombos-{{ section_id }} .p-laundry { background-image: var(--p-laundry); aspect-ratio: 0.6302; }
  #PurelaneCombos-{{ section_id }} .p-wm { background-image: var(--p-wm); aspect-ratio: 0.6148; }
  #PurelaneCombos-{{ section_id }} .p-floor { background-image: var(--p-floor); aspect-ratio: 0.6312; }
  #PurelaneCombos-{{ section_id }} .p-handwash { background-image: var(--p-handwash); aspect-ratio: 0.7453; }
  #PurelaneCombos-{{ section_id }} .p-toilet { background-image: var(--p-toilet); aspect-ratio: 0.6139; }
  #PurelaneCombos-{{ section_id }} .p-eraser { background-image: var(--p-eraser); aspect-ratio: 1.3187; }
</style>

<script>
(function() {
  var sectionId = {{ section_id | json }};
  var container = document.getElementById('PurelaneCombos-' + sectionId);
  if (!container) return;

  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Reveal on scroll */
  var revEls = container.querySelectorAll('.rv');
  if ('IntersectionObserver' in window && !reduce) {
    var ro = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          ro.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
    revEls.forEach(function(el) { ro.observe(el); });
  } else {
    revEls.forEach(function(el) { el.classList.add('in'); });
  }

  /* Theme Editor Support */
  if (window.Shopify && window.Shopify.designMode) {
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === sectionId) {
        var els = container.querySelectorAll('.rv');
        els.forEach(function(el) { el.classList.add('in'); });
      }
    });
  }
})();
</script>

