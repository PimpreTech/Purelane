{{ 'purelane-header.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Purelane Header & Navigation Section
  Renders the announcement ticker marquee, floating curved glass navpill,
  brand mark, menu links, tools, mobile drawer, and progress rail.
{%- endcomment -%}

{%- liquid
  assign section_id = section.id
  assign enable_ticker = section.settings.enable_ticker
  assign enable_progress_rail = section.settings.enable_progress_rail
-%}

<div class="purelane-header-container purelane-header__section" data-section-id="{{ section_id }}" data-section-type="purelane-header">
  {%- if enable_ticker -%}
    <div class="purelane-ticker" aria-label="Store announcement ticker">
      <div class="purelane-ticker__track">
        <span>Free shipping <b>on every bundle across India</b></span>
        <span>100% plant-based <b>and non-toxic</b></span>
        <span>Loved by <b>30,000+ happy homes</b></span>
        <span>Buy 3 <b>at flat ₹499</b></span>
        <span>Free shipping <b>on every bundle across India</b></span>
        <span>100% plant-based <b>and non-toxic</b></span>
        <span>Loved by <b>30,000+ happy homes</b></span>
        <span>Buy 3 <b>at flat ₹499</b></span>
      </div>
    </div>
  {%- endif -%}

  <header id="hdr" class="purelane-header">
    <div class="purelane-navpill glass">
      <a class="purelane-brand" href="{{ routes.root_url }}" aria-label="Purelane home">
        <span class="purelane-brand__mark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/>
            <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/>
          </svg>
        </span>
        <span class="purelane-brand__txt">
          <span class="purelane-brand__n1">{{ shop.name | default: 'Purelane' }}</span>
          <span class="purelane-brand__n2">Clean, simply</span>
        </span>
      </a>

      <nav class="purelane-nav" aria-label="Main navigation">
        {%- if section.settings.menu.links.size > 0 -%}
          {%- for link in section.settings.menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="{{ routes.root_url }}">Home</a>
          <a href="#combos">Combos</a>
          <a href="#bundles">Bundles</a>
          <a href="#shop">Shop</a>
          <a href="#reviews">Reviews</a>
        {%- endif -%}
      </nav>

      <div class="purelane-navtools">
        <a class="purelane-ico hide-s" href="{{ routes.search_url }}" aria-label="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/>
            <path d="m20 20-3.5-3.5"/>
          </svg>
        </a>
        <a class="purelane-ico hide-s" href="{{ routes.account_url }}" aria-label="Account">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="8" r="3.6"/>
            <path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/>
          </svg>
        </a>
        <a class="purelane-ico" href="{{ routes.cart_url }}" aria-label="Cart">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/>
            <circle cx="10" cy="20.5" r="1.1"/>
            <circle cx="17.5" cy="20.5" r="1.1"/>
          </svg>
          <span class="purelane-dot">{{ cart.item_count }}</span>
        </a>
        <button id="purelaneBurger" class="purelane-ico purelane-burger" type="button" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="purelaneMobileDrawer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M4 8h16M4 16h16"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  {%- comment -%} Mobile Navigation Drawer {%- endcomment -%}
  <div id="purelaneMobileDrawer" class="purelane-mobile-drawer" aria-hidden="true">
    {%- if section.settings.menu.links.size > 0 -%}
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    {%- else -%}
      <a href="{{ routes.root_url }}">Home</a>
      <a href="#combos">Combos</a>
      <a href="#bundles">Bundles</a>
      <a href="#shop">Shop</a>
      <a href="#reviews">Reviews</a>
    {%- endif -%}
    <a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
    <a href="{{ routes.account_url }}">My Account</a>
  </div>

  {%- if enable_progress_rail -%}
    <nav class="purelane-progress-rail" aria-label="Section progress">
      <a href="#PurelaneHero-hero" class="on" aria-label="Hero"></a>
      <a href="#PurelaneReviews-reviews" aria-label="Reviews"></a>
      <a href="#PurelaneCombos-combos" aria-label="Combos"></a>
      <a href="#PurelaneBundles-bundles" aria-label="Bundles"></a>
      <a href="#PurelaneShop-shop" aria-label="Shop"></a>
    </nav>
  {%- endif -%}
</div>

<script>
(function() {
  var hdr = document.getElementById('hdr');
  var burger = document.getElementById('purelaneBurger');
  var drawer = document.getElementById('purelaneMobileDrawer');

  /* Scroll position header transition */
  function onScroll() {
    var y = window.scrollY || window.pageYOffset;
    if (hdr) {
      if (y > 90) {
        hdr.classList.add('up');
      } else {
        hdr.classList.remove('up');
      }
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });

  /* Mobile menu toggle */
  if (burger && drawer) {
    burger.addEventListener('click', function() {
      var isOpen = drawer.classList.contains('open');
      if (isOpen) {
        drawer.classList.remove('open');
        drawer.setAttribute('aria-hidden', 'true');
        burger.setAttribute('aria-expanded', 'false');
      } else {
        drawer.classList.add('open');
        drawer.setAttribute('aria-hidden', 'false');
        burger.setAttribute('aria-expanded', 'true');
      }
    });

    drawer.querySelectorAll('a').forEach(function(link) {
      link.addEventListener('click', function() {
        drawer.classList.remove('open');
        drawer.setAttribute('aria-hidden', 'true');
        burger.setAttribute('aria-expanded', 'false');
      });
    });

    /* Escape key closes mobile drawer */
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && drawer.classList.contains('open')) {
        drawer.classList.remove('open');
        drawer.setAttribute('aria-hidden', 'true');
        burger.setAttribute('aria-expanded', 'false');
        burger.focus();
      }
    });
  }

  /* Progress rail sync */
  var railLinks = document.querySelectorAll('.purelane-progress-rail a');
  if (railLinks.length > 0) {
    var targets = Array.prototype.map.call(railLinks, function(a) {
      var href = a.getAttribute('href');
      return href ? document.querySelector(href) : null;
    });

    function syncRail() {
      var mid = window.scrollY + window.innerHeight * 0.42;
      var idx = 0;
      targets.forEach(function(t, i) {
        if (t && t.offsetTop <= mid) idx = i;
      });
      railLinks.forEach(function(a, i) {
        if (i === idx) {
          a.classList.add('on');
        } else {
          a.classList.remove('on');
        }
      });
    }
    window.addEventListener('scroll', syncRail, { passive: true });
  }
})();
</script>

{% schema %}
{
  "name": "Purelane Header",
  "tag": "section",
  "class": "purelane-header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "enable_ticker",
      "label": "Enable top announcement ticker",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_progress_rail",
      "label": "Enable side section progress rail",
      "default": true
    }
  ]
}
{% endschema %}
