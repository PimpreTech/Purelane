{{ 'purelane-hero.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Purelane Hero Section
  Reproduces the hero from the reference prototype as a Shopify section.
  All content is merchant-editable via section settings.
{%- endcomment -%}

{%- liquid
  assign section_id = section.id
  assign heading_line1 = section.settings.heading_line1
  assign heading_line2 = section.settings.heading_line2
  assign heading_line3 = section.settings.heading_line3
  assign lede = section.settings.lede
  assign cta_primary_text = section.settings.cta_primary_text
  assign cta_primary_url = section.settings.cta_primary_url
  assign cta_secondary_text = section.settings.cta_secondary_text
  assign cta_secondary_url = section.settings.cta_secondary_url
  assign badge1_text = section.settings.badge1_text
  assign badge2_text = section.settings.badge2_text
  assign badge3_text = section.settings.badge3_text
  assign enable_animations = section.settings.enable_animations
  assign enable_product_slider = section.settings.enable_product_slider
  assign hero_image = section.settings.hero_image
  assign slide1_label = section.settings.slide1_label
  assign slide1_price = section.settings.slide1_price
  assign slide1_compare = section.settings.slide1_compare
  assign slide1_saving = section.settings.slide1_saving
  assign slide2_label = section.settings.slide2_label
  assign slide2_price = section.settings.slide2_price
  assign slide2_compare = section.settings.slide2_compare
  assign slide2_saving = section.settings.slide2_saving
  assign slide3_label = section.settings.slide3_label
  assign slide3_price = section.settings.slide3_price
  assign slide3_compare = section.settings.slide3_compare
  assign slide3_saving = section.settings.slide3_saving
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div id="PurelaneHero-{{ section_id }}" class="purelane-hero" data-section-id="{{ section_id }}" data-section-type="purelane-hero">

  {%- comment -%} ====== ANIMATED BACKGROUND (scenes + water + bubbles) ====== {%- endcomment -%}
  <div class="purelane-hero__scenes" aria-hidden="true">
    <div class="purelane-hero__scene purelane-hero__scene--1 on"></div>

    <div class="purelane-hero__water">
      {%- comment -%} Water caustics layer A — procedural SVG {%- endcomment -%}
      <div class="purelane-hero__wl purelane-hero__wl--a">
        <svg class="sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="plcg-{{ section_id }}" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#eafff4" stop-opacity="0"/>
              <stop offset=".18" stop-color="#f2fff8" stop-opacity=".95"/>
              <stop offset=".5" stop-color="#ffffff" stop-opacity="1"/>
              <stop offset=".82" stop-color="#e6fbef" stop-opacity=".9"/>
              <stop offset="1" stop-color="#eafff4" stop-opacity="0"/>
            </linearGradient>
            <filter id="plwf-{{ section_id }}" x="-12%" y="-12%" width="124%" height="124%" color-interpolation-filters="sRGB">
              <feTurbulence type="fractalNoise" baseFrequency="0.0022 0.019" numOctaves="3" seed="21" result="n"/>
              <feDisplacementMap in="SourceGraphic" in2="n" scale="72" xChannelSelector="R" yChannelSelector="G"/>
            </filter>
          </defs>
          <g filter="url(#plwf-{{ section_id }})">
            <path d="M262 230 Q372 261 482 238 Q592 247 702 250 Q812 210 923 235 Q1033 201 1143 213 Q1253 232 1363 215 Q1473 261 1583 238 Q1694 248 1804 250" stroke="url(#plcg-{{ section_id }})" stroke-width="1.7" fill="none" opacity="0.45" stroke-linecap="round"/>
            <path d="M137 256 Q307 242 477 258 Q646 238 816 245 Q985 259 1155 247 Q1324 277 1494 262 Q1664 267 1833 269" stroke="url(#plcg-{{ section_id }})" stroke-width="5.1" fill="none" opacity="0.23" stroke-linecap="round"/>
            <path d="M389 715 Q514 756 639 725 Q763 738 888 742 Q1013 688 1138 721 Q1262 674 1387 692 Q1512 716 1636 694 Q1761 756 1886 724" stroke="url(#plcg-{{ section_id }})" stroke-width="5.7" fill="none" opacity="0.37" stroke-linecap="round"/>
            <path d="M140 308 Q297 310 454 302 Q611 321 769 312 Q926 314 1083 316 Q1240 298 1397 309 Q1555 295 1712 300 Q1869 309 2026 301" stroke="url(#plcg-{{ section_id }})" stroke-width="5.5" fill="none" opacity="0.47" stroke-linecap="round"/>
            <path d="M570 422 Q687 462 805 437 Q922 436 1039 446 Q1156 391 1274 423 Q1391 388 1508 398 Q1625 432 1742 406 Q1860 462 1977 436" stroke="url(#plcg-{{ section_id }})" stroke-width="2.3" fill="none" opacity="0.25" stroke-linecap="round"/>
            <path d="M51 390 Q154 420 258 394 Q361 414 465 411 Q568 376 672 400 Q776 357 879 376 Q983 384 1086 371 Q1190 419 1293 393 Q1397 415 1500 411" stroke="url(#plcg-{{ section_id }})" stroke-width="4.7" fill="none" opacity="0.42" stroke-linecap="round"/>
            <path d="M-155 181 Q-22 183 111 168 Q244 207 377 188 Q510 195 643 198 Q776 164 909 185 Q1042 156 1175 166" stroke="url(#plcg-{{ section_id }})" stroke-width="3.3" fill="none" opacity="0.49" stroke-linecap="round"/>
            <path d="M108 333 Q262 355 416 346 Q570 331 724 344 Q879 309 1033 327 Q1187 320 1341 318 Q1495 348 1650 329 Q1804 355 1958 346" stroke="url(#plcg-{{ section_id }})" stroke-width="3.4" fill="none" opacity="0.39" stroke-linecap="round"/>
            <path d="M460 369 Q585 362 711 357 Q837 384 963 368 Q1089 386 1214 381 Q1340 365 1466 377 Q1592 350 1718 363 Q1843 361 1969 357" stroke="url(#plcg-{{ section_id }})" stroke-width="6.6" fill="none" opacity="0.44" stroke-linecap="round"/>
          </g>
        </svg>
      </div>

      {%- comment -%} Light shaft layer C {%- endcomment -%}
      <div class="purelane-hero__wl purelane-hero__wl--c">
        <svg class="sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="plsg-{{ section_id }}" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#f4fff9" stop-opacity=".85"/>
              <stop offset=".38" stop-color="#dcf6e7" stop-opacity=".28"/>
              <stop offset="1" stop-color="#d4f2e2" stop-opacity="0"/>
            </linearGradient>
          </defs>
          <g>
            <polygon points="95,-80 152,-80 517,1180 439,1180" fill="url(#plsg-{{ section_id }})" opacity="0.26"/>
            <polygon points="433,-80 491,-80 885,1180 807,1180" fill="url(#plsg-{{ section_id }})" opacity="0.41"/>
            <polygon points="751,-80 919,-80 1180,1180 953,1180" fill="url(#plsg-{{ section_id }})" opacity="0.31"/>
            <polygon points="1048,-80 1135,-80 1400,1180 1282,1180" fill="url(#plsg-{{ section_id }})" opacity="0.28"/>
            <polygon points="1366,-80 1520,-80 1898,1180 1690,1180" fill="url(#plsg-{{ section_id }})" opacity="0.28"/>
            <polygon points="1695,-80 1808,-80 2067,1180 1914,1180" fill="url(#plsg-{{ section_id }})" opacity="0.35"/>
          </g>
        </svg>
      </div>

      {%- comment -%} Surface layer S {%- endcomment -%}
      <div class="purelane-hero__wl purelane-hero__wl--s">
        <svg class="sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="plsf-{{ section_id }}" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#ffffff" stop-opacity=".55"/>
              <stop offset=".55" stop-color="#e8fff2" stop-opacity=".16"/>
              <stop offset="1" stop-color="#e8fff2" stop-opacity="0"/>
            </linearGradient>
            <filter id="plsfw-{{ section_id }}" x="-10%" y="-40%" width="120%" height="180%" color-interpolation-filters="sRGB">
              <feTurbulence type="fractalNoise" baseFrequency="0.004 0.05" numOctaves="2" seed="9" result="n"/>
              <feDisplacementMap in="SourceGraphic" in2="n" scale="30" xChannelSelector="R" yChannelSelector="G"/>
            </filter>
          </defs>
          <g filter="url(#plsfw-{{ section_id }})">
            <rect x="-100" y="-40" width="2000" height="150" fill="url(#plsf-{{ section_id }})"/>
            <rect x="-100" y="60" width="2000" height="60" fill="url(#plsf-{{ section_id }})" opacity=".5"/>
          </g>
        </svg>
      </div>

      {%- comment -%} Bubbles {%- endcomment -%}
      <div class="purelane-hero__bub">
        <span style="--x:91.9%;--s:6.7px;--dur:21.5s;--dly:19.0s;--drift:-11px"></span>
        <span style="--x:43.4%;--s:5.7px;--dur:26.8s;--dly:16.1s;--drift:-11px"></span>
        <span style="--x:96.6%;--s:6.2px;--dur:13.7s;--dly:10.3s;--drift:38px"></span>
        <span style="--x:6.0%;--s:3.6px;--dur:24.4s;--dly:10.6s;--drift:3px"></span>
        <span style="--x:70.3%;--s:3.3px;--dur:20.9s;--dly:9.2s;--drift:-39px"></span>
        <span style="--x:67.7%;--s:4.0px;--dur:27.0s;--dly:16.5s;--drift:-5px"></span>
        <span style="--x:2.1%;--s:7.1px;--dur:22.0s;--dly:3.1s;--drift:-37px"></span>
        <span style="--x:69.4%;--s:8.1px;--dur:21.9s;--dly:10.7s;--drift:-24px"></span>
        <span style="--x:64.1%;--s:8.2px;--dur:17.3s;--dly:9.0s;--drift:2px"></span>
        <span style="--x:21.8%;--s:7.1px;--dur:15.7s;--dly:18.4s;--drift:-13px"></span>
        <span style="--x:61.9%;--s:6.6px;--dur:26.3s;--dly:7.2s;--drift:-23px"></span>
        <span style="--x:45.9%;--s:8.9px;--dur:24.3s;--dly:7.2s;--drift:20px"></span>
      </div>
    </div>

    <div class="purelane-hero__vig"></div>
  </div>

  {%- comment -%} ====== HERO SECTION ====== {%- endcomment -%}
  <section class="purelane-hero__section" aria-label="{{ heading_line1 }} {{ heading_line2 }} {{ heading_line3 }}">
    <div class="purelane-hero__grid">

      {%- comment -%} Desktop badge rail {%- endcomment -%}
      <div class="purelane-hero__badges" aria-label="Product promises">
        {%- if badge1_text != blank -%}
          <div class="purelane-hero__badge">
            <span class="purelane-hero__badge-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
            </span>
            <span>{{ badge1_text }}</span>
          </div>
        {%- endif -%}
        {%- if badge2_text != blank -%}
          <div class="purelane-hero__badge">
            <span class="purelane-hero__badge-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
            </span>
            <span>{{ badge2_text }}</span>
          </div>
        {%- endif -%}
        {%- if badge3_text != blank -%}
          <div class="purelane-hero__badge">
            <span class="purelane-hero__badge-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
            </span>
            <span>{{ badge3_text }}</span>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Hero copy {%- endcomment -%}
      <div class="purelane-hero__copy">
        <h1 class="pl-d1 purelane-hero__rv{% unless enable_animations %} in{% endunless %}">
          {%- if heading_line1 != blank -%}{{ heading_line1 }}<br>{%- endif -%}
          {%- if heading_line2 != blank -%}{{ heading_line2 }}<br>{%- endif -%}
          {%- if heading_line3 != blank -%}<span class="pl-lime">{{ heading_line3 }}</span>{%- endif -%}
        </h1>

        <div class="purelane-hero__rule purelane-hero__rv purelane-hero__rv-d1{% unless enable_animations %} in{% endunless %}">
          <i></i>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          <i></i>
        </div>

        {%- if lede != blank -%}
          <p class="pl-lede purelane-hero__rv purelane-hero__rv-d2{% unless enable_animations %} in{% endunless %}">{{ lede }}</p>
        {%- endif -%}

        <div class="purelane-hero__cta purelane-hero__rv purelane-hero__rv-d3{% unless enable_animations %} in{% endunless %}">
          {%- if cta_primary_text != blank -%}
            <a class="pl-btn pl-btn--primary" href="{{ cta_primary_url | default: '#' }}">
              {{ cta_primary_text }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            </a>
          {%- endif -%}
          {%- if cta_secondary_text != blank -%}
            <a class="pl-btn pl-btn--ghost" href="{{ cta_secondary_url | default: '#' }}">{{ cta_secondary_text }}</a>
          {%- endif -%}
        </div>

        {%- comment -%} Mobile badge strip {%- endcomment -%}
        <div class="purelane-hero__badgestrip purelane-hero__rv purelane-hero__rv-d4{% unless enable_animations %} in{% endunless %}">
          {%- if badge1_text != blank -%}
            <div class="purelane-hero__badgestrip-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
              {{ badge1_text }}
            </div>
          {%- endif -%}
          {%- if badge2_text != blank -%}
            <div class="purelane-hero__badgestrip-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
              {{ badge2_text }}
            </div>
          {%- endif -%}
          {%- if badge3_text != blank -%}
            <div class="purelane-hero__badgestrip-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
              {{ badge3_text }}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Hero product area {%- endcomment -%}
      <div class="purelane-hero__prod" id="purelane-hero-prod-{{ section_id }}">
        {%- if hero_image -%}
          {%- comment -%} If merchant uploaded an image, display it {%- endcomment -%}
          <div class="purelane-hero__stage" style="display:flex;align-items:flex-end;justify-content:flex-end;">
            {{ hero_image | image_url: width: 1120 | image_tag:
              alt: hero_image.alt | default: heading_line1,
              loading: 'eager',
              fetchpriority: 'high',
              widths: '375, 550, 750, 1100',
              sizes: '(max-width: 900px) min(88vw, 420px), min(50vw, 560px)',
              style: 'width:100%;height:auto;object-fit:contain;'
            }}
          </div>
        {%- elsif enable_product_slider -%}
          {%- comment -%} Product slider with SVG placeholder bottles {%- endcomment -%}
          <div class="purelane-hero__stage" id="purelane-hero-stage-{{ section_id }}">
            {%- comment -%} Slide 1: single product {%- endcomment -%}
            <div class="purelane-hero__slide purelane-hero__slide--1 on" data-n="1">
              <span class="purelane-hero__hp p-kbtl a d1" role="img" aria-label="{{ slide1_label | default: 'Product bottle' }}" style="background-image:var(--p-kbtl)"></span>
              <div class="purelane-hero__ptag">
                <span class="purelane-hero__ptag-label">{{ slide1_label | default: 'Single bottle' }}</span>
                <span class="purelane-hero__ptag-val">
                  <strong>{{ slide1_price | default: '₹200' }}</strong>
                  {%- if slide1_compare != blank -%}<s>{{ slide1_compare }}</s>{%- endif -%}
                </span>
                {%- if slide1_saving != blank -%}
                  <span class="purelane-hero__ptag-cut">{{ slide1_saving }}</span>
                {%- endif -%}
              </div>
            </div>

            {%- comment -%} Slide 2: two products {%- endcomment -%}
            <div class="purelane-hero__slide purelane-hero__slide--2" data-n="2">
              <span class="purelane-hero__hp p-tbtl a d1" role="img" aria-label="{{ slide2_label | default: 'Product bottle' }}" style="background-image:var(--p-tbtl)"></span>
              <span class="purelane-hero__hp p-kbtl b d2" role="img" aria-label="Product bottle" style="background-image:var(--p-kbtl)"></span>
              <div class="purelane-hero__ptag">
                <span class="purelane-hero__ptag-label">{{ slide2_label | default: 'Any 2 products' }}</span>
                <span class="purelane-hero__ptag-val">
                  <strong>{{ slide2_price | default: '₹349' }}</strong>
                  {%- if slide2_compare != blank -%}<s>{{ slide2_compare }}</s>{%- endif -%}
                </span>
                {%- if slide2_saving != blank -%}
                  <span class="purelane-hero__ptag-cut">{{ slide2_saving }}</span>
                {%- endif -%}
              </div>
            </div>

            {%- comment -%} Slide 3: three products {%- endcomment -%}
            <div class="purelane-hero__slide purelane-hero__slide--3" data-n="3">
              <span class="purelane-hero__hp p-tbtl a d1" role="img" aria-label="{{ slide3_label | default: 'Product bottle' }}" style="background-image:var(--p-tbtl)"></span>
              <span class="purelane-hero__hp p-mbtl b d2" role="img" aria-label="Product bottle" style="background-image:var(--p-mbtl)"></span>
              <span class="purelane-hero__hp p-kbtl c d3" role="img" aria-label="Product bottle" style="background-image:var(--p-kbtl)"></span>
              <div class="purelane-hero__ptag">
                <span class="purelane-hero__ptag-label">{{ slide3_label | default: 'Any 3 products' }}</span>
                <span class="purelane-hero__ptag-val">
                  <strong>{{ slide3_price | default: '₹499' }}</strong>
                  {%- if slide3_compare != blank -%}<s>{{ slide3_compare }}</s>{%- endif -%}
                </span>
                {%- if slide3_saving != blank -%}
                  <span class="purelane-hero__ptag-cut">{{ slide3_saving }}</span>
                {%- endif -%}
              </div>
            </div>
          </div>

          {%- comment -%} Dots {%- endcomment -%}
          <div class="purelane-hero__dots" id="purelane-hero-dots-{{ section_id }}">
            <button type="button" class="on" aria-label="Show 1 product"></button>
            <button type="button" aria-label="Show 2 products"></button>
            <button type="button" aria-label="Show 3 products"></button>
          </div>
        {%- else -%}
          {%- comment -%} Placeholder when no image and slider disabled {%- endcomment -%}
          <div class="purelane-hero__stage" style="display:flex;align-items:center;justify-content:center;">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

    </div>
  </section>
</div>

{%- comment -%} ====== PRODUCT SVG DEFINITIONS (inline for slider) ====== {%- endcomment -%}
{%- if enable_product_slider and hero_image == blank -%}
<style>
  #PurelaneHero-{{ section_id }} {
    --p-kbtl:url("data:image/svg+xml;base64,");
    --p-tbtl:url("data:image/svg+xml;base64,");
    --p-mbtl:url("data:image/svg+xml;base64,");
  }
</style>
{%- endif -%}

{%- comment -%} ====== JAVASCRIPT (minimal, section-safe) ====== {%- endcomment -%}
<script>
(function() {
  var sectionId = {{ section_id | json }};
  var container = document.getElementById('PurelaneHero-' + sectionId);
  if (!container) return;

  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- Reveal on scroll ---------- */
  var revEls = container.querySelectorAll('.purelane-hero__rv');
  if ('IntersectionObserver' in window && !reduce) {
    var ro = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          ro.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
    revEls.forEach(function(el) { ro.observe(el); });
  } else {
    revEls.forEach(function(el) { el.classList.add('in'); });
  }

  /* ---------- Hero product slider ---------- */
  var stage = document.getElementById('purelane-hero-stage-' + sectionId);
  if (stage) {
    var slides = Array.prototype.slice.call(stage.querySelectorAll('.purelane-hero__slide'));
    var dotsContainer = document.getElementById('purelane-hero-dots-' + sectionId);
    var dots = dotsContainer ? Array.prototype.slice.call(dotsContainer.querySelectorAll('button')) : [];
    var currentSlide = 0;
    var timer = null;

    function goToSlide(n) {
      currentSlide = ((n % slides.length) + slides.length) % slides.length;
      slides.forEach(function(s, i) { s.classList.toggle('on', i === currentSlide); });
      dots.forEach(function(d, i) { d.classList.toggle('on', i === currentSlide); });
    }

    function play() {
      if (!timer && !reduce) {
        timer = setInterval(function() { goToSlide(currentSlide + 1); }, 3800);
      }
    }

    function stop() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    dots.forEach(function(d, i) {
      d.addEventListener('click', function() { stop(); goToSlide(i); play(); });
    });

    stage.addEventListener('mouseenter', stop);
    stage.addEventListener('mouseleave', play);

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) { play(); } else { stop(); }
        });
      }, { threshold: 0.2 }).observe(stage);
    } else {
      play();
    }
  }

  /* ---------- Theme Editor support ---------- */
  if (window.Shopify && window.Shopify.designMode) {
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === sectionId) {
        // Re-run reveals
        var els = container.querySelectorAll('.purelane-hero__rv');
        els.forEach(function(el) { el.classList.add('in'); });
      }
    });
  }
})();
</script>

